# Copy to .env (gitignored). Never commit the real file. On Railway, set the same names as
# service variables instead.

# --- tools/publish ---
SUPABASE_URL=https://rxyzicrfcgnkdinkuspi.supabase.co
# Dashboard > Project Settings > API Keys > Secret key. Bypasses RLS: never put it in the app.
SUPABASE_SECRET_KEY=

# --- content-service (review screen) ---
# Dashboard > Connect > Session pooler. Connect as content_service, never as postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=content_service.rxyzicrfcgnkdinkuspi
SPRING_DATASOURCE_PASSWORD=
# Your name as it should appear on every sign-off, and a password of 16+ characters.
FOREWAY_REVIEWER_NAME=
FOREWAY_REVIEWER_PASSWORD=
# Local http only. Leave unset on Railway, where cookies must be https-only.
FOREWAY_SECURE_COOKIE=false
