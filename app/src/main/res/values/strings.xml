<resources>
    <string name="app_name">Foreway</string>

    <!--
      Every sentence a student reads about an eligibility outcome lives here, and nowhere
      else. The rules engine reports structured facts; this file decides the wording.

      That split is what makes a Hindi or Tamil build possible — add values-hi and nothing
      in the engine changes. It does NOT remove the need for a release to change wording,
      because this file ships in the APK. Serving copy from the content store would.
    -->

